{
  "name": "sanity-toolkit",
  "version": "1.0.0",
  "description": "The Universal Compatibility Layer for Sanity CMS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sanity-core": {
      "types": "./dist/sanity-core/index.d.ts",
      "default": "./dist/sanity-core/index.js"
    },
    "./sanity-adapters": {
      "types": "./dist/sanity-adapters/index.d.ts",
      "default": "./dist/sanity-adapters/index.js"
    },
    "./sanity-ui-kit": {
      "types": "./dist/sanity-ui-kit/index.d.ts",
      "default": "./dist/sanity-ui-kit/index.js"
    },
    "./sanity-components": {
      "types": "./dist/sanity-components/index.d.ts",
      "default": "./dist/sanity-components/index.js"
    },
    "./sanity-skills": {
      "types": "./dist/sanity-skills/index.d.ts",
      "default": "./dist/sanity-skills/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.14",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jest-environment-jsdom": "^29.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@types/react": "^18.0.0 || ^19.0.0"
  }
}
